{
  "name": "@retcd/client",
  "version": "0.1.0",
  "description": "Node.js client for a rEtcd cluster: get, put, compare-and-set, list, glob, watch, files, presence",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "proto",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-force-exit --test-timeout=30000 \"test/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node scripts/bundle-proto.mjs",
    "postpack": "node scripts/bundle-proto.mjs --clean"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
