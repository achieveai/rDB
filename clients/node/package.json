{
  "name": "@retcd/client",
  "version": "0.1.0",
  "description": "Node.js client for a rEtcd cluster: get, put, compare-and-set, list, glob, watch, files, presence",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  }
}
